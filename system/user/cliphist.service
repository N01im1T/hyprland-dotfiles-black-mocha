[Unit]
Description=Black Mocha clipboard history
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/bash -c 'wl-paste --type text --watch cliphist store & wl-paste --type image --watch cliphist store & wait'
Restart=on-failure

[Install]
WantedBy=graphical-session.target
